# --- Gemini (pick one) ---
# Gemini Developer API key (recommended for deployment): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Or Vertex AI with Application Default Credentials (gcloud auth application-default login)
GOOGLE_CLOUD_PROJECT=
# gemini-3.5-flash is served from Vertex's "global" endpoint; us-central1 only has gemini-2.5-flash.
GOOGLE_CLOUD_LOCATION=global
# Optional override; defaults to gemini-3.5-flash, falling back to gemini-2.5-flash
GEMINI_MODEL=

# --- Tiger Data (TimescaleDB). Leave empty to use the in-memory store. ---
DATABASE_URL=

# --- ElevenLabs text-to-speech. Leave empty to use the browser's speechSynthesis. ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

NEXT_PUBLIC_APP_NAME=Schuylkill Sentinel
# Public URL, used for OpenGraph images (e.g. https://yourdomain.tech)
NEXT_PUBLIC_SITE_URL=

# --- Testing knobs ---
# FORCE_FIXTURES=1   # pretend USGS/Open-Meteo are down (cached-data banner)
# AGENT_MODE=mock    # skip Gemini, use the offline agent
